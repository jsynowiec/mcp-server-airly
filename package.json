{
  "name": "@jsynowiec/mcp-server-airly",
  "version": "0.1.5",
  "description": "An MCP server for querying Airly air quality data",
  "author": "Jakub Synowiec",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-server-airly": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "imports": {
    "#/*": {
      "bun": "./src/*",
      "default": "./dist/*"
    },
    "#tests/*": "./tests/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev:test": "bun test --watch",
    "prebuild": "bun run lint && bun run typecheck && bun run test",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "lru-cache": "^11.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.4",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsynowiec/mcp-server-airly.git"
  },
  "bugs": {
    "url": "https://github.com/jsynowiec/mcp-server-airly/issues"
  },
  "homepage": "https://github.com/jsynowiec/mcp-server-airly#readme",
  "keywords": [
    "mcp",
    "airly",
    "air-quality",
    "model-context-protocol"
  ]
}
